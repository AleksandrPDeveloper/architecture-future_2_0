        <mxCell id="p1oX5EHxLQhcvxlmByr3-72" value="&lt;p style=&quot;caret-color: rgb(0, 0, 0); text-align: start;&quot; data-pm-slice=&quot;1 1 []&quot;&gt;снабжение, операционный блок,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;запасы, поставки, закупки, склады, сервисное обслуживание мед‑оборудования&lt;/span&gt;&lt;/p&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" vertex="1" parent="p1oX5EHxLQhcvxlmByr3-70">
